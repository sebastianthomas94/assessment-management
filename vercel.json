{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @assessment-management/client build",
  "outputDirectory": "apps/client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://assessment-api-bcf07a.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
